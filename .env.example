# Local development only. Choose a private password; percent-encode special URL characters.
# Writer credentials are used only by Python ingestion, migrations and the Docker wrapper.
DATABASE_URL=postgresql://atlante:change-me@127.0.0.1:5432/atlante_irpinia
# Run npm run db:reader after db:migrate to generate a separate private DATABASE_READ_URL.
# Nuxt only reads DATABASE_READ_URL; do not reuse the writer login for the API.
# Set these in production only after completing and reviewing the privacy policy.
NUXT_PUBLIC_ANALYTICS_ID=
NUXT_PUBLIC_ANALYTICS_POLICY_READY=false
