# Only the public application source and its build metadata enter the image.
**
!Dockerfile
!package.json
!package-lock.json
!nuxt.config.ts
!tsconfig.json
!app
!app/**
!server
!server/**
!shared
!shared/**
!public
!public/**
!config
!config/sources.json
!scripts
!scripts/start.mjs
# Credentials and local evidence must never enter a build context.
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.dump
